{
  "name": "motion-studio-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @motion-studio/web build && pnpm --filter @motion-studio/cli build",
    "dev": "pnpm --parallel --filter @motion-studio/core --filter @motion-studio/web dev",
    "motion-studio": "pnpm build && node apps/cli/dist/main.js"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "@types/node": "^24.0.0"
  }
}
