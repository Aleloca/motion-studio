{
  "$schema": "motion-studio/composition@1",
  "width": 1080, "height": 1920, "fps": 30, "duration": 6, "background": "#0b1020",
  "fonts": [{ "family": "SpikeFont", "src": "assets/spikefont.ttf" }],
  "scenes": [
    { "id": "intro", "name": "Intro", "start": 0, "duration": 2 },
    { "id": "photo", "name": "Foto", "start": 2, "duration": 2 },
    { "id": "outro", "name": "Outro", "start": 4, "duration": 2 }
  ],
  "tracks": [
    { "id": "bg", "kind": "video", "clips": [
      { "id": "bgv", "type": "video", "src": "assets/bg.mp4", "start": 0, "duration": 6, "props": { "x": 0, "y": 0, "width": 1080, "height": 1920 } }
    ]},
    { "id": "visual", "kind": "visual", "clips": [
      { "id": "card", "type": "shape", "scene": "intro", "start": 0, "duration": 2, "props": { "x": 90, "y": 500, "width": 900, "height": 700, "fill": "#0b1020cc", "radius": 48 },
        "animations": [{ "preset": "fadeIn", "duration": 0.3 }] },
      { "id": "photo1", "type": "image", "scene": "photo", "src": "assets/photo.jpg", "start": 2, "duration": 2,
        "props": { "x": 60, "y": 300, "width": 960, "height": 1300, "kenBurns": { "from": { "scale": 1.0 }, "to": { "scale": 1.25, "x": -40, "y": -60 } } },
        "animations": [{ "preset": "fadeIn", "duration": 0.25 }] },
      { "id": "outro-html", "type": "html", "scene": "outro", "src": "layers/outro.html", "start": 4, "duration": 2,
        "props": { "x": 0, "y": 400, "width": 1080, "height": 1100 } }
    ]},
    { "id": "text", "kind": "text", "clips": [
      { "id": "title", "type": "text", "scene": "intro", "start": 0.2, "duration": 1.8,
        "props": { "text": "Motion Studio", "x": 90, "y": 640, "width": 900, "fontFamily": "SpikeFont", "fontSize": 120, "color": "#ffffff", "align": "center" },
        "animations": [{ "preset": "slideUp", "duration": 0.6 }, { "preset": "fadeIn", "duration": 0.5 }] },
      { "id": "subtitle", "type": "text", "scene": "intro", "start": 0.6, "duration": 1.4,
        "props": { "text": "render spike", "x": 90, "y": 900, "width": 900, "fontFamily": "SpikeFont", "fontSize": 72, "color": "#fbbf24", "align": "center" },
        "animations": [{ "prop": "scale", "from": 0.6, "to": 1, "duration": 0.5, "ease": "cubic-bezier(.34,1.56,.64,1)" }, { "preset": "fadeIn", "duration": 0.3 }] },
      { "id": "caption", "type": "text", "scene": "photo", "start": 2.3, "duration": 1.7,
        "props": { "text": "Ken Burns", "x": 60, "y": 1640, "width": 960, "fontFamily": "SpikeFont", "fontSize": 96, "color": "#ffffff", "align": "center" },
        "animations": [{ "prop": "x", "keyframes": [{ "t": 0, "v": -1000 }, { "t": 0.4, "v": 0, "ease": "ease-out" }, { "t": 1, "v": 0 }], "duration": 1.7 }] }
    ]},
    { "id": "logo", "kind": "visual", "clips": [
      { "id": "logo1", "type": "svg", "src": "assets/logo.svg", "start": 0, "duration": 6, "props": { "x": 860, "y": 1700, "width": 160, "height": 160, "fit": "contain" },
        "animations": [{ "prop": "rotation", "from": -180, "to": 0, "duration": 1 }, { "preset": "popIn", "duration": 1 }] }
    ]},
    { "id": "audio", "kind": "audio", "clips": [
      { "id": "music", "type": "audio", "src": "assets/music.wav", "start": 0, "duration": 6, "volume": 0.35, "fadeIn": 0.5, "fadeOut": 1.0 },
      { "id": "vo", "type": "audio", "src": "assets/voice.wav", "start": 0.5, "duration": 4, "volume": 1.0 },
      { "id": "whoosh", "type": "audio", "src": "assets/sfx.wav", "start": 2.0, "duration": 0.15, "volume": 0.8 },
      { "id": "ding", "type": "audio", "src": "assets/sfx.wav", "start": 4.0, "duration": 0.15, "volume": 0.8 }
    ]}
  ]
}
